# WalletConnect / Reown (required for connect modal; add your domain in Reown Dashboard → Project Domains)
VITE_REOWN_PROJECT_ID=

# Quote API (required for same-chain swap quotes). Must be reachable from the browser;
# use a public HTTPS URL when the app is on HTTPS (e.g. Vercel). Avoid local IPs in production.
VITE_MANGO_SERVICES_URL=
VITE_MANGO_SERVICES_API_KEY=

# Router contract per chain (optional if set in src/chains.json)
VITE_ETHEREUM_ROUTER=
VITE_OPTIMISM_ROUTER=
VITE_BSC_ROUTER=
VITE_POLYGON_ROUTER=
VITE_BASE_ROUTER=
VITE_ARBITRUM_ROUTER=
VITE_AVALANCHE_ROUTER=

# Access passphrase gate (optional). Set to "true" to require a passphrase before entering the app.
# VITE_ACCESS_GATE_ENABLED=true
# VITE_ACCESS_PASSPHRASE=

# Referrer address for swap (optional)
VITE_REFERRER_ADDRESS=

# CoinGecko API key (optional). Used for token logos and backend /api/v1/price if set.
# Get one at https://www.coingecko.com/en/api (reduces rate limits / 429).
VITE_COINGECKO_API_KEY=
COINGECKO_API_KEY=
