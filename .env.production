# MangoSwap — Production Frontend Environment Variables
# Used by Vite at build time (vite build --mode production).
# All VITE_* values are inlined into the JS bundle — do NOT put secrets here.

# ── WalletConnect / Reown ─────────────────────────────────────────────────────
# Register your domain at https://cloud.reown.com → Project Domains
VITE_REOWN_PROJECT_ID=d1e4867bd0b1fdc19e40af935262591e

# ── Backend API (mangoServices) ───────────────────────────────────────────────
# When set to https://api.mangoswap.io and the app runs on *.mangoswap.io,
# mangoServicesBaseUrl.js returns '' so the frontend uses relative /api/... paths.
# Vercel's vercel.json rewrites /api/* → https://api.mangoswap.io/api/* server-side,
# keeping everything same-origin from the browser's perspective (no CORS headers needed).
VITE_MANGO_SERVICES_URL=https://api.mangoswap.io
# API key — must match API_KEY in mangoServices/.env on the server
VITE_MANGO_SERVICES_API_KEY=eaba00ab0e7c5a6e1e61f0635a5c4de1

# ── Router contracts (optional — can also be set in src/chains.json) ──────────
VITE_BASE_ROUTER=0xB544a23Ce919c49Dee2626F7D326460411Ccf992
VITE_ETHEREUM_ROUTER=0xF6872B49DbDEF24f6155bEDFE514a36d12E7bb52
VITE_OPTIMISM_ROUTER=0x1d84E8080231EF3316F9A831D389384fdC05a357
VITE_BSC_ROUTER=0x1d84E8080231EF3316F9A831D389384fdC05a357
VITE_POLYGON_ROUTER=0x1d84E8080231EF3316F9A831D389384fdC05a357
VITE_ARBITRUM_ROUTER=0x1d84E8080231EF3316F9A831D389384fdC05a357
VITE_AVALANCHE_ROUTER=0x1d84E8080231EF3316F9A831D389384fdC05a357

# ── Default referrer (optional) ───────────────────────────────────────────────
# If set, used as fallback referrer when no ?ref= param is in the URL.
VITE_REFERRER_ADDRESS=

# ── CoinGecko (optional) ──────────────────────────────────────────────────────
# Used for token logos and price lookups in the frontend.
# Get a free Demo key at https://www.coingecko.com/en/api
VITE_COINGECKO_API_KEY=
