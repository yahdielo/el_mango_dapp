{
  "framework": "vite",
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.(png|jpg|jpeg|gif|svg|webp)$).*)",
      "destination": "/index.html"
    }
  ]
}
